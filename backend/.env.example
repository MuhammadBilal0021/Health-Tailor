# Live deployments require a PostgreSQL URL; no secrets are bundled.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/healthtailor?sslmode=require
APP_ENV=production
COOKIE_SECURE=true
# Optional Gemini integration. Empty means explicit unavailable response.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Exact browser origins for local/separate-project reverse proxies (comma-separated).
FRONTEND_ORIGINS=http://localhost:3000
