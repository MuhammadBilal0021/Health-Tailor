# Demo is the default and requires no cloud credentials.
APP_MODE=demo
PORT=5000
# Live mode requires a newly generated random secret (at least 32 characters).
SECRET_KEY=
COOKIE_SECURE=false
# Live Firebase configuration; keep credential files outside the repository.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
# Optional AI and email integrations, disabled in demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SUPPORT_EMAIL=
